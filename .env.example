# ---------------------------------------------------------------------------
# TOG's Web — example environment
#
# Copy to `.env` and fill in your OWN values. Every variable is optional:
# the app builds and runs without any of them, individual features simply
# stay disabled instead of falling back to somebody else's backend.
#
#   cp .env.example .env
# ---------------------------------------------------------------------------

# --- Deployment -------------------------------------------------------------
# Public base path of the build. Leave empty for root hosting (Netlify,
# Vercel, custom domain). GitHub Actions derives "/<your-repo>/" automatically,
# so you only need this for non-standard setups.
VITE_BASE_PATH=

# Absolute public URL of your deployment, used for canonical/OpenGraph tags,
# robots.txt and sitemap.xml. Auto-derived on GitHub Pages; leave empty to
# omit SEO URLs entirely.
VITE_SITE_URL=

# --- Backend (Supabase) — powers the AI chat page ---------------------------
# Create your own free project, then deploy supabase/functions/ai-chat to it.
# Without these the AI page shows a "backend not configured" notice.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# --- Chat page (Firebase Realtime Database) ---------------------------------
# Create your own Firebase project with Realtime Database enabled.
# Without these the Chat page shows a "chat not configured" notice.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=

# Staff passwords for the chat page. Change these if you enable chat.
VITE_CHAT_OWNER_PASSWORD=
VITE_CHAT_ADMIN_PASSWORD=
VITE_CHAT_MOD_PASSWORD=

# --- Proxy ------------------------------------------------------------------
# Default Wisp relay used by the Scramjet proxy. Defaults to the public
# Mercury Workshop relay; point it at your own relay if you host one.
VITE_WISP_URL=

# Optional HTTP proxy server (Settings -> Proxy also sets this per-browser).
VITE_PROXY_URL=

# --- Optional assets --------------------------------------------------------
# Origin serving large, CDN-offloaded game bundles. Leave empty to serve
# everything from your own deployment.
VITE_ASSET_ORIGIN=

# --- Music ------------------------------------------------------------------
# CDN base for the music library. Point at your own jsDelivr/GitHub repo.
VITE_MUSIC_CDN=
